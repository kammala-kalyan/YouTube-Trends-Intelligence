{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "statedetail",
  "displayName": "State detail",
  "displayOption": "FitToPage",
  "height": 720,
  "width": 1280,
  "filterConfig": {
    "filters": [
      {
        "name": "fdrill",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "dim_state"
              }
            },
            "Property": "state"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      }
    ]
  },
  "pageBinding": {
    "name": "drillstate",
    "type": "Drillthrough",
    "parameters": []
  },
  "type": "Drillthrough",
  "visibility": "HiddenInViewMode",
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#ffffff'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#ffffff'"
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}