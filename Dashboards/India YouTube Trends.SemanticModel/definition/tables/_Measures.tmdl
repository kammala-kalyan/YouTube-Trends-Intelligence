/// Home table for all measures.
table _Measures
	lineageTag: 69694657-e5d6-4f62-b185-8688b43da289

	/// Distinct videos in the current filter.
	measure 'Videos Tracked' = DISTINCTCOUNT(fact_video_snapshot[video_id])
		formatString: #,0
		displayFolder: Videos
		lineageTag: a0a097c3-1136-4d8c-9609-3010eecc6479

	/// Most recent snapshot date in the current filter.
	measure 'Latest Snapshot' = MAX(fact_video_snapshot[snapshot_date])
		formatString: yyyy-mm-dd
		displayFolder: Videos
		lineageTag: 0fee23ac-6cd5-4570-ab79-46a417fde40a

	/// Sum of each video's latest public view count (counted once per video, not once per snapshot).
	measure 'Total Views' =
			SUMX(
			    VALUES(fact_video_snapshot[video_id]),
			    CALCULATE(MAX(fact_video_snapshot[views]))
			)
		formatString: #,0
		displayFolder: Videos
		lineageTag: 1e1f3d65-955e-493e-a6da-aa14f48c3aa1

	/// Sum of each video's latest like count. Hidden likes are blank, not zero.
	measure 'Total Likes' =
			SUMX(
			    VALUES(fact_video_snapshot[video_id]),
			    CALCULATE(MAX(fact_video_snapshot[likes]))
			)
		formatString: #,0
		displayFolder: Videos
		lineageTag: 1cf6df57-7f9a-4ef8-9572-a4cfae2113b2

	/// Sum of each video's latest comment count.
	measure 'Total Comments' =
			SUMX(
			    VALUES(fact_video_snapshot[video_id]),
			    CALCULATE(MAX(fact_video_snapshot[comments]))
			)
		formatString: #,0
		displayFolder: Videos
		lineageTag: e6fd70e4-3296-4628-bbc3-b2f22033e374

	/// (Likes + comments) / views, using only videos whose likes are public, so hidden likes don't drag the rate down.
	measure 'Engagement Rate' =
			VAR vids = CALCULATETABLE(VALUES(fact_video_snapshot[video_id]), fact_video_snapshot[likes_hidden] = FALSE())
			VAR likes = SUMX(vids, CALCULATE(MAX(fact_video_snapshot[likes])))
			VAR comments = SUMX(vids, CALCULATE(MAX(fact_video_snapshot[comments])))
			VAR views = SUMX(vids, CALCULATE(MAX(fact_video_snapshot[views])))
			RETURN DIVIDE(likes + comments, views)
		formatString: 0.0%
		displayFolder: Videos
		lineageTag: 0544b876-93c6-43f2-93a1-272371d4f642

	/// Average of views / days since publish, using each video's latest snapshot.
	measure 'Avg Views per Day' =
			AVERAGEX(
			    VALUES(fact_video_snapshot[video_id]),
			    VAR d = CALCULATE(MAX(fact_video_snapshot[snapshot_date]))
			    RETURN CALCULATE(AVERAGE(fact_video_snapshot[views_per_day]), fact_video_snapshot[snapshot_date] = d)
			)
		formatString: #,0
		displayFolder: Videos
		lineageTag: 89cf5014-3a33-47e9-a733-67a167303d51

	/// Median latest view count per video. Less skewed by viral outliers than the average.
	measure 'Median Views' =
			MEDIANX(
			    VALUES(fact_video_snapshot[video_id]),
			    CALCULATE(MAX(fact_video_snapshot[views]))
			)
		formatString: #,0
		displayFolder: Videos
		lineageTag: 13e12bf4-4a74-416a-8476-b8447a162d10

	/// Share of videos that are Shorts.
	measure 'Shorts Share' = DIVIDE(CALCULATE([Videos Tracked], dim_video[is_short] = TRUE()), [Videos Tracked])
		formatString: 0.0%
		displayFolder: Videos
		lineageTag: d9d424ef-903d-4ccf-9c44-873c42f05d99

	/// Share of videos in an Indian language other than English (includes Hindi, Tamil, Telugu, etc., per dim_language[is_indian_regional]).
	measure 'Regional Language Share' = DIVIDE(CALCULATE([Videos Tracked], dim_language[is_indian_regional] = TRUE()), [Videos Tracked])
		formatString: 0.0%
		displayFolder: Videos
		lineageTag: 42fc0c7c-d848-40e0-83bf-fb3221aa6621

	/// Videos that appeared in an India mostPopular chart (overall or per category).
	measure 'Trending Videos' = CALCULATE([Videos Tracked], fact_video_snapshot[in_trending] = TRUE())
		formatString: #,0
		displayFolder: Videos
		lineageTag: 202eb9ec-74a9-4ef5-ac4f-64ce30b0212e

	/// Category with the most videos in the current filter.
	measure 'Top Category' =
			MAXX(
			    TOPN(1, FILTER(VALUES(dim_category[category_name]), [Videos Tracked] > 0), [Videos Tracked]),
			    dim_category[category_name]
			)
		displayFolder: Videos
		lineageTag: 0e597388-b0d7-45e1-8d16-18b431ca7349

	/// Distinct channels behind the videos in the current filter.
	measure Channels = COUNTROWS(SUMMARIZE(fact_video_snapshot, dim_video[channel_id]))
		formatString: #,0
		displayFolder: Channels
		lineageTag: 824681cb-4a23-4d89-b0d7-86bbb744e810

	/// Subscribers summed over the channels behind the videos in view (each channel once). Hidden subscriber counts are blank.
	measure 'Total Subscribers' =
			SUMX(
			    SUMMARIZE(fact_video_snapshot, dim_channel[channel_id], dim_channel[subscribers]),
			    dim_channel[subscribers]
			)
		formatString: #,0
		displayFolder: Channels
		lineageTag: 477c39d2-ed89-4f82-9126-84070b9678f7

	/// Total Subscribers / Channels.
	measure 'Avg Subscribers per Channel' = DIVIDE([Total Subscribers], [Channels])
		formatString: #,0
		displayFolder: Channels
		lineageTag: 63b7bb4a-3ef5-48a4-a543-c80e7e584d8f

	/// Share of channels in view whose country is set to somewhere other than India (Unknown counts as not outside).
	measure 'Channels Outside India Share' =
			DIVIDE(
			    COUNTROWS(FILTER(SUMMARIZE(fact_video_snapshot, dim_channel[channel_id], dim_channel[channel_origin]), dim_channel[channel_origin] = "Outside India")),
			    [Channels]
			)
		formatString: 0.0%
		displayFolder: Channels
		lineageTag: 70dde7ef-ee20-4f6b-bf97-fc4cc0cdebd4

	/// Google Trends interest, normalised to the 'cricket' anchor so keywords are comparable across batches. Relative index, not search counts.
	measure Interest = AVERAGE(fact_trends_keyword[interest_norm])
		formatString: 0.0
		displayFolder: Trends
		lineageTag: 219e06be-aeec-47d2-b1bc-7f63d188a6b3

	/// Average interest in the last month vs the month before (ending at the latest date in context).
	measure 'Interest MoM %' =
			VAR cur  = CALCULATE([Interest], DATESINPERIOD(dim_date[date], MAX(dim_date[date]), -1, MONTH))
			VAR prev = CALCULATE([Interest], DATEADD(DATESINPERIOD(dim_date[date], MAX(dim_date[date]), -1, MONTH), -1, MONTH))
			RETURN DIVIDE(cur - prev, prev)
		formatString: 0.0%
		displayFolder: Trends
		lineageTag: 572a8b34-52b6-40b7-aad0-13092a72e927

	/// Average interest over the last 3 months vs the same 3 months a year earlier.
	measure 'Interest YoY % (3M)' =
			VAR cur  = CALCULATE([Interest], DATESINPERIOD(dim_date[date], MAX(dim_date[date]), -3, MONTH))
			VAR prev = CALCULATE([Interest], SAMEPERIODLASTYEAR(DATESINPERIOD(dim_date[date], MAX(dim_date[date]), -3, MONTH)))
			RETURN DIVIDE(cur - prev, prev)
		formatString: 0.0%
		displayFolder: Trends
		lineageTag: 8c681183-b8d6-49c5-942d-97b9d54998fa

	/// Rising / Declining = more than +/-15% vs the previous month. Low volume = too few searches for a reliable change (last-month score under 0.5).
	measure 'Trend Status' =
			SWITCH(TRUE(),
			    ISBLANK([Interest MoM %]) || [Recent Interest] < 0.5, "Low volume",
			    [Interest MoM %] > 0.15, "Rising",
			    [Interest MoM %] < -0.15, "Declining",
			    "Stable")
		displayFolder: Trends
		lineageTag: d8399fc3-3073-4fc2-bc7e-3c22790b3a47

	/// 0-100 within a keyword: how strongly each state searches it relative to the top state.
	measure 'State Index' = AVERAGE(fact_trends_region[state_index])
		formatString: 0.0
		displayFolder: Regions
		lineageTag: 4c8a1b7f-3546-4adb-a338-62b79300f49f

	/// State interest in the keyword relative to 'cricket' in the same state (1.0 = as popular as cricket).
	measure 'Interest vs Cricket' = AVERAGE(fact_trends_region[ratio_to_anchor])
		formatString: 0.00
		displayFolder: Regions
		lineageTag: 4013e879-c5e8-4ffd-bf3e-9f0b643359c8

	/// State with the highest State Index for the keywords in the current filter.
	measure 'Top State' =
			MAXX(
			    TOPN(1, FILTER(VALUES(dim_state[state]), NOT ISBLANK([State Index])), [State Index]),
			    dim_state[state]
			)
		displayFolder: Regions
		lineageTag: bcb753c2-d572-4b0d-b9ba-3dbc4a3cdda8

	/// Average normalised Trends interest over the last 12 weeks.
	measure 'Demand Index' = AVERAGE(fact_keyword_opportunity[demand_index])
		formatString: 0.0
		displayFolder: Opportunities
		lineageTag: ddf7257d-2d63-440e-8703-4e677f3f97fb

	/// Search API totalResults for videos in the last 30 days. Approximate and capped at 1,000,000, so a relative signal only.
	measure 'Supply (30d videos, est.)' = SUM(fact_keyword_opportunity[videos_last_30d_est])
		formatString: #,0
		displayFolder: Opportunities
		lineageTag: 51c79b40-c008-4c84-9325-13a1c1781f8c

	/// Interest in the last 12 weeks vs the previous 12 weeks.
	measure 'Growth 12w %' = AVERAGE(fact_keyword_opportunity[growth_12w])
		formatString: 0.0%
		displayFolder: Opportunities
		lineageTag: 6c90d0cf-f60f-4bd7-b553-d794531831aa

	/// Share of the keyword's top recent videos from channels under 100K subscribers.
	measure 'Small Channel Share' = AVERAGE(fact_keyword_opportunity[small_channel_share])
		formatString: 0.0%
		displayFolder: Opportunities
		lineageTag: 00c42758-f1d7-4834-8b9e-519dcca55d8b

	/// Keywords (excluding the anchor) whose interest rose more than 15% month on month.
	measure 'Rising Keywords' = COUNTROWS(FILTER(CALCULATETABLE(VALUES(dim_keyword[keyword]), dim_keyword[is_anchor] = FALSE()), [Trend Status] = "Rising"))
		formatString: #,0
		displayFolder: Trends
		lineageTag: 70a13349-192e-4c2a-aae5-f1ba0a7d3144

	/// Keywords (excluding the anchor) whose interest fell more than 15% month on month.
	measure 'Declining Keywords' = COUNTROWS(FILTER(CALCULATETABLE(VALUES(dim_keyword[keyword]), dim_keyword[is_anchor] = FALSE()), [Trend Status] = "Declining"))
		formatString: #,0
		displayFolder: Trends
		lineageTag: 7c60eebd-f30a-4d0e-a1dd-729135c4a256

	/// Hex colour for Trend Status (works on both YouTube light and dark themes). Rising green, Declining orange (red is reserved for the brand accent), Stable grey.
	measure 'Trend Status Color' = SWITCH([Trend Status], "Rising", "#1f9142", "Declining", "#c4630b", "Stable", "#909090", "#717171")
		displayFolder: Trends
		lineageTag: 0c858a25-d810-429a-812d-8b81e837bf43

	/// Keyword with the highest State Index in the current state(s). Excludes the anchor.
	measure 'Top Keyword in State' =
			MAXX(
			    TOPN(1, FILTER(CALCULATETABLE(VALUES(dim_keyword[keyword]), dim_keyword[is_anchor] = FALSE()), NOT ISBLANK([State Index])), [State Index]),
			    dim_keyword[keyword]
			)
		displayFolder: Regions
		lineageTag: 589b23d6-2504-433b-9fca-8acc0913a665

	/// Total Views / Videos Tracked. Skewed by viral videos; compare with Median Views.
	measure 'Avg Views per Video' = DIVIDE([Total Views], [Videos Tracked])
		formatString: #,0
		displayFolder: Videos
		lineageTag: 1ea21d98-91c2-44c0-8019-12dd9ea147f8

	/// Tracked videos by their publish date (uses the inactive dim_video[published_date] relationship). For upload-volume-over-time charts.
	measure 'Videos Published' = CALCULATE(COUNTROWS(dim_video), USERELATIONSHIP(dim_video[published_date], dim_date[date]))
		formatString: #,0
		displayFolder: Videos
		lineageTag: e9bda333-4b13-4b0e-b5ba-e7b16e1ab439

	/// Header text showing the latest snapshot date (ignores slicers and filters).
	measure 'Data As Of' = "Data as of " & FORMAT(CALCULATE(MAX(fact_video_snapshot[snapshot_date]), REMOVEFILTERS()), "d mmm yyyy")
		displayFolder: Labels
		lineageTag: c9eb9e63-e74f-4025-bdb0-72d949f46723

	/// Dynamic title fragment describing the keyword selection.
	measure 'Selected Keyword Label' =
			VAR n = COUNTROWS(VALUES(dim_keyword[keyword]))
			RETURN SWITCH(TRUE(),
			    NOT ISFILTERED(dim_keyword[keyword]) && NOT ISFILTERED(dim_keyword[topic_group]), "All keywords",
			    n = 1, SELECTEDVALUE(dim_keyword[keyword]),
			    ISFILTERED(dim_keyword[topic_group]) && HASONEVALUE(dim_keyword[topic_group]), SELECTEDVALUE(dim_keyword[topic_group]) & " keywords",
			    FORMAT(n, "0") & " keywords")
		displayFolder: Labels
		lineageTag: 022d808c-bbb6-41af-9181-8ac1e7d06231

	/// Dynamic title for the India map.
	measure 'Map Title' =
			VAR lbl = [Selected Keyword Label]
			RETURN IF(lbl = "All keywords", "Where India searches on YouTube (all tracked keywords)", "Where India searches for " & lbl & " on YouTube")
		displayFolder: Labels
		lineageTag: 60312b3c-a63b-42ee-91ba-c29b8136778d

	/// Title for the state drill-through page.
	measure 'State Page Title' = SELECTEDVALUE(dim_state[state], "Select a state") & ": what people search on YouTube"
		displayFolder: Labels
		lineageTag: 773fa16b-63c9-46a9-a4f5-3788351164da

	measure 'Icon Videos' =
			VAR c = "%23e8002d"
			VAR p = "<rect x='2' y='5' width='20' height='14' rx='3'/><path d='M10 9l5 3-5 3z' fill='" & c & "'/>"
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='12' fill='" & c & "' fill-opacity='0.13'/><g transform='translate(8 8)' fill='none' stroke='" & c & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" & p & "</g></svg>"
		displayFolder: Icons
		lineageTag: 7c51ec94-9f64-47d7-bf12-34f1d2284de4
		dataCategory: ImageUrl

	measure 'Icon Views' =
			VAR c = "%232a7ae6"
			VAR p = "<path d='M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z'/><circle cx='12' cy='12' r='3'/>"
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='12' fill='" & c & "' fill-opacity='0.13'/><g transform='translate(8 8)' fill='none' stroke='" & c & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" & p & "</g></svg>"
		displayFolder: Icons
		lineageTag: c0fc41c3-3b42-4d8c-8b5a-b8ee3db33c8f
		dataCategory: ImageUrl

	measure 'Icon Engagement' =
			VAR c = "%23d93a87"
			VAR p = "<path d='M12 20s-7-4.4-9.2-8.6C1.3 8.5 3 5 6.5 5c2 0 3.5 1.2 5.5 3.2C14 6.2 15.5 5 17.5 5c3.5 0 5.2 3.5 3.7 6.4C19 15.6 12 20 12 20z'/>"
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='12' fill='" & c & "' fill-opacity='0.13'/><g transform='translate(8 8)' fill='none' stroke='" & c & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" & p & "</g></svg>"
		displayFolder: Icons
		lineageTag: c98d97b3-59b0-442c-90c4-edcb7de3ed6e
		dataCategory: ImageUrl

	measure 'Icon Shorts' =
			VAR c = "%238b5cf6"
			VAR p = "<rect x='6' y='2' width='12' height='20' rx='3'/><path d='M13 7l-3 5h4l-3 5'/>"
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='12' fill='" & c & "' fill-opacity='0.13'/><g transform='translate(8 8)' fill='none' stroke='" & c & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" & p & "</g></svg>"
		displayFolder: Icons
		lineageTag: 6760cbc6-2360-4a67-81da-9079b0b1d9f6
		dataCategory: ImageUrl

	measure 'Icon Language' =
			VAR c = "%231f9142"
			VAR p = "<circle cx='12' cy='12' r='9'/><path d='M3 12h18'/><path d='M12 3c3 3.5 3 14.5 0 18c-3-3.5-3-14.5 0-18z'/>"
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='12' fill='" & c & "' fill-opacity='0.13'/><g transform='translate(8 8)' fill='none' stroke='" & c & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" & p & "</g></svg>"
		displayFolder: Icons
		lineageTag: aa3ca30e-0b27-424a-8a55-146240741994
		dataCategory: ImageUrl

	measure 'Icon Category' =
			VAR c = "%23c4630b"
			VAR p = "<path d='M8 4h8v5a4 4 0 0 1-8 0z'/><path d='M8 6H5a3 3 0 0 0 3 4'/><path d='M16 6h3a3 3 0 0 1-3 4'/><path d='M12 13v4'/><path d='M8 20h8'/><path d='M10 17h4'/>"
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='12' fill='" & c & "' fill-opacity='0.13'/><g transform='translate(8 8)' fill='none' stroke='" & c & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" & p & "</g></svg>"
		displayFolder: Icons
		lineageTag: b49f535a-8d36-4f2a-a697-4d0adc2cb7f9
		dataCategory: ImageUrl

	measure 'Icon Channels' =
			VAR c = "%2308899b"
			VAR p = "<circle cx='12' cy='8' r='4'/><path d='M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6'/>"
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='12' fill='" & c & "' fill-opacity='0.13'/><g transform='translate(8 8)' fill='none' stroke='" & c & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" & p & "</g></svg>"
		displayFolder: Icons
		lineageTag: ce3b76a3-7bea-441e-93a7-69c1d936e10b
		dataCategory: ImageUrl

	measure 'Icon Subscribers' =
			VAR c = "%238b5cf6"
			VAR p = "<path d='M6 16v-5a6 6 0 0 1 12 0v5l1.5 2h-15z'/><path d='M10 21h4'/>"
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='12' fill='" & c & "' fill-opacity='0.13'/><g transform='translate(8 8)' fill='none' stroke='" & c & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" & p & "</g></svg>"
		displayFolder: Icons
		lineageTag: be800ea2-912c-4183-860c-6b98808439a5
		dataCategory: ImageUrl

	measure 'Icon Trending' =
			VAR c = "%23e8002d"
			VAR p = "<path d='M12 3c1 3 5 5.5 5 10a5 5 0 0 1-10 0c0-2.2 1-3.6 2.2-4.6 0 2 1 3.4 2.3 3.4C11.5 9 11 6 12 3z'/>"
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='12' fill='" & c & "' fill-opacity='0.13'/><g transform='translate(8 8)' fill='none' stroke='" & c & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" & p & "</g></svg>"
		displayFolder: Icons
		lineageTag: 5ad2a42a-bb62-4f87-baf6-dbae15ebb4a3
		dataCategory: ImageUrl

	measure 'Icon Rising' =
			VAR c = "%231f9142"
			VAR p = "<path d='M3 17l6-6 4 4 8-8'/><path d='M15 7h6v6'/>"
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='12' fill='" & c & "' fill-opacity='0.13'/><g transform='translate(8 8)' fill='none' stroke='" & c & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" & p & "</g></svg>"
		displayFolder: Icons
		lineageTag: e4364184-7992-432b-937c-781f8379808a
		dataCategory: ImageUrl

	measure 'Icon Declining' =
			VAR c = "%23c4630b"
			VAR p = "<path d='M3 7l6 6 4-4 8 8'/><path d='M15 17h6v-6'/>"
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='12' fill='" & c & "' fill-opacity='0.13'/><g transform='translate(8 8)' fill='none' stroke='" & c & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" & p & "</g></svg>"
		displayFolder: Icons
		lineageTag: 6c0e1884-0cd0-4b58-8790-8ec3ae743657
		dataCategory: ImageUrl

	measure 'Icon Interest' =
			VAR c = "%232a7ae6"
			VAR p = "<circle cx='11' cy='11' r='7'/><path d='M20 20l-4-4'/>"
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='12' fill='" & c & "' fill-opacity='0.13'/><g transform='translate(8 8)' fill='none' stroke='" & c & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" & p & "</g></svg>"
		displayFolder: Icons
		lineageTag: e20c69e8-31f0-4c84-9be5-1d859966b15b
		dataCategory: ImageUrl

	measure 'Icon State' =
			VAR c = "%23d93a87"
			VAR p = "<path d='M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z'/><circle cx='12' cy='10' r='2.5'/>"
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='12' fill='" & c & "' fill-opacity='0.13'/><g transform='translate(8 8)' fill='none' stroke='" & c & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>" & p & "</g></svg>"
		displayFolder: Icons
		lineageTag: 1d8116ed-18d1-40eb-9547-68df77842371
		dataCategory: ImageUrl

	measure 'Icon Opportunity' =
			VAR c = "%23c4630b"
