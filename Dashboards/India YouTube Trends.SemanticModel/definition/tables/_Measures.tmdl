			VAR r = DIVIDE(v, mx)
			RETURN IF(ISBLANK(v), BLANK(), SWITCH(TRUE(), r >= 0.999, "#c4002b", r >= 0.8, "#d2434b", r >= 0.6, "#de686a", r >= 0.4, "#e98889", r >= 0.2, "#f2a8a9", "#f9c6c9"))
		displayFolder: Colors
		lineageTag: fb5e526e-3c99-4fe3-90fd-b5916c809c02

