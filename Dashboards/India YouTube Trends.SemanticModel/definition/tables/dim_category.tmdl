/// YouTube video categories for India (from videoCategories API).
table dim_category
	lineageTag: 4a187653-c90a-436f-99cc-ab25e39ee0d8

	column category_id
		dataType: string
		lineageTag: c1658402-f4fa-4f7a-81f4-a0ef801b5715
		sourceColumn: category_id

	column category_name
		dataType: string
		lineageTag: 5d266069-5824-4bcc-853f-f1d3de57c270
		sourceColumn: category_name

	column assignable
		dataType: boolean
		lineageTag: 5ccba188-d838-4af6-a791-ada3a899a487
		sourceColumn: assignable

	/// True when at least one tracked video is in this category. Used to hide empty categories in slicers.
	column has_videos = CALCULATE(COUNTROWS(dim_video)) > 0
		dataType: boolean
		lineageTag: ce86b2d0-9bf2-4608-be5f-5f4d0a04d307
		summarizeBy: none

	partition dim_category = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(DataFolder & "dim_category.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"category_id", type text}, {"category_name", type text}, {"assignable", type logical}}, "en-US")
				in
				    Typed

