/// Calendar, one row per day, 2021-10-31 to the latest snapshot.
table dim_date
	lineageTag: aa175f57-b8dc-46a6-a696-c527cb9f07a5
	dataCategory: Time

	column date
		dataType: dateTime
		isUnique
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 07077385-a55b-404d-b6f1-807c1b1f0dfb
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		formatString: 0
		lineageTag: 85d5c013-d4ef-48e3-bf35-02befbbb7e4b
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: string
		lineageTag: 6e55f35d-f82b-4406-bd2c-4e157519decb
		sourceColumn: quarter

	column month_num
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2cc9a3f1-5e36-44b0-85e9-1890e42178b6
		summarizeBy: none
		sourceColumn: month_num

	column month_name
		dataType: string
		lineageTag: f0784bb4-1e71-4318-8be7-2a7011431f14
		sourceColumn: month_name
		sortByColumn: month_num

	column year_month
		dataType: string
		lineageTag: 6be0c076-be14-4b3c-93a5-0f17095b389d
		sourceColumn: year_month

	column week_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: e867c329-4147-41f9-a853-ccfb3fafd84c
		summarizeBy: none
		sourceColumn: week_start

		annotation UnderlyingDateTimeDataType = Date

	column weekday
		dataType: string
		lineageTag: 375a6e96-1d91-4175-a7a6-51defe412c04
		sourceColumn: weekday
		sortByColumn: weekday_num

	column weekday_num
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d2fb6677-85d2-43b2-a881-8dd3e9cfe741
		summarizeBy: none
		sourceColumn: weekday_num

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(DataFolder & "dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date", type date}, {"year", Int64.Type}, {"quarter", type text}, {"month_num", Int64.Type}, {"month_name", type text}, {"year_month", type text}, {"week_start", type date}, {"weekday", type text}, {"weekday_num", Int64.Type}}, "en-US")
				in
				    Typed

