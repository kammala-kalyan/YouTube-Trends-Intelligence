/// Channel x snapshot day: subscribers, total views and video count.
table fact_channel_snapshot
	lineageTag: 60cd7955-9fd8-451a-98da-5440dee75a0c

	column snapshot_date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: fdaa33d6-a45f-4170-9095-fc2b307fd9ed
		summarizeBy: none
		sourceColumn: snapshot_date

	column channel_id
		dataType: string
		isHidden
		lineageTag: 20fced50-8063-42fd-a476-6ed7fed619c1
		sourceColumn: channel_id

	column subscribers
		dataType: int64
		formatString: #,0
		lineageTag: d02e364d-bffb-4e1f-add6-f904629aa298
		sourceColumn: subscribers

	column total_views
		dataType: int64
		formatString: #,0
		lineageTag: 4acbe563-05e3-40ae-b3cd-5b31e0524030
		sourceColumn: total_views

	column video_count
		dataType: int64
		formatString: #,0
		lineageTag: 4e1a6ed3-eeb1-4bd5-bb5b-1851cc0c82b9
		sourceColumn: video_count

	partition fact_channel_snapshot = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_channel_snapshot.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"snapshot_date", type date}, {"channel_id", type text}, {"subscribers", Int64.Type}, {"total_views", Int64.Type}, {"video_count", Int64.Type}}, "en-US")
				in
				    Typed

