/// Google Trends (YouTube Search, India) weekly interest per keyword. interest_norm is made comparable across batches via the 'cricket' anchor.
table fact_trends_keyword
	lineageTag: dfa6bcf8-0c18-4601-ae90-2e306a7bd2ca

	column date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 10ed5b01-4af9-4134-8f20-edf4c83c96b8
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column keyword
		dataType: string
		isHidden
		lineageTag: ba187708-10c9-4fc9-938a-f5c6a584b728
		summarizeBy: none
		sourceColumn: keyword

		annotation SummarizationSetBy = Automatic

	column interest_raw
		dataType: double
		formatString: 0.0
		lineageTag: 50a50bfa-c64f-4a48-93c9-7773d8992f1d
		summarizeBy: sum
		sourceColumn: interest_raw

		annotation SummarizationSetBy = Automatic

	column interest_norm
		dataType: double
		formatString: 0.0
		lineageTag: 03361de2-771c-45c4-897d-e99b98a1c451
		summarizeBy: sum
		sourceColumn: interest_norm

		annotation SummarizationSetBy = Automatic

	column snapshot_date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: c4272320-4465-4949-8e0b-e54b0d332d1b
		summarizeBy: none
		sourceColumn: snapshot_date

		variation Variation
			isDefault
			relationship: dcfe07e1-b37d-44e7-83fc-b1b1abfad5b5
			defaultHierarchy: LocalDateTable_87b79045-8eb3-4c3e-b7eb-7f1d2c875536.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	partition fact_trends_keyword = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(DataFolder & "fact_trends_keyword.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date", type date}, {"keyword", type text}, {"interest_raw", type number}, {"interest_norm", type number}, {"snapshot_date", type date}}, "en-US")
				in
				    Typed

