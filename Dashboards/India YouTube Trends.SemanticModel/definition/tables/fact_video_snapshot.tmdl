/// Video x snapshot day: public views, likes, comments, trending ranks and engagement. Trending = mostPopular chart only (survivorship bias).
table fact_video_snapshot
	lineageTag: bd084282-fbac-499d-87d2-e833b297532c

	column snapshot_date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: fc257e4e-a870-4bb2-b6a7-a25d4abb1235
		summarizeBy: none
		sourceColumn: snapshot_date

		annotation UnderlyingDateTimeDataType = Date

	column video_id
		dataType: string
		isHidden
		lineageTag: 5977a008-0006-45b4-915d-a4beb73facab
		sourceColumn: video_id

	column views
		dataType: int64
		formatString: #,0
		lineageTag: 51e2ee88-f268-45d4-8955-0202444be691
		sourceColumn: views

	column likes
		dataType: int64
		formatString: #,0
		lineageTag: 22a66d20-4bd9-4205-9769-b68edfe9974e
		sourceColumn: likes

	column comments
		dataType: int64
		formatString: #,0
		lineageTag: 9259f76b-b548-48d6-8402-4daf6cc7b538
		sourceColumn: comments

	column in_trending
		dataType: boolean
		lineageTag: b28be324-13a5-429b-a155-74660993c464
		sourceColumn: in_trending

	column in_topic_search
		dataType: boolean
		lineageTag: 9d2d3a57-0db4-472b-b0ad-e9ea4104a54a
		sourceColumn: in_topic_search

	column trending_rank_overall
		dataType: int64
		formatString: 0
		lineageTag: 9baae843-3140-424a-a169-b6546ade44e7
		summarizeBy: none
		sourceColumn: trending_rank_overall

	column trending_rank_category
		dataType: int64
		formatString: 0
		lineageTag: baa7fa32-5c28-4997-ab76-57f90b77dfd4
		summarizeBy: none
		sourceColumn: trending_rank_category

	column charts_count
		dataType: int64
		formatString: 0
		lineageTag: d141f7a7-838e-49e5-84b9-f55096e26c40
		summarizeBy: none
		sourceColumn: charts_count

	column days_since_publish
		dataType: double
		formatString: #,0.0
		lineageTag: 41506bf3-9c6c-42ca-a03d-d14b6858bf26
		summarizeBy: none
		sourceColumn: days_since_publish

	column views_per_day
		dataType: double
		formatString: #,0
		lineageTag: 0372e74d-7a49-474d-b44e-4bbfd1a0ab48
		summarizeBy: none
		sourceColumn: views_per_day

	column likes_hidden
		dataType: boolean
		lineageTag: 9221de26-debb-46b3-9c10-7f9dd45e97d6
		sourceColumn: likes_hidden

	column engagement_rate
		dataType: double
		formatString: 0.0%
		lineageTag: e1cd1ec8-00ce-4d2c-8e6c-2852f513e891
		summarizeBy: none
		sourceColumn: engagement_rate

	partition fact_video_snapshot = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(DataFolder & "fact_video_snapshot.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"snapshot_date", type date}, {"video_id", type text}, {"views", Int64.Type}, {"likes", Int64.Type}, {"comments", Int64.Type}, {"in_trending", type logical}, {"in_topic_search", type logical}, {"trending_rank_overall", Int64.Type}, {"trending_rank_category", Int64.Type}, {"charts_count", Int64.Type}, {"days_since_publish", type number}, {"views_per_day", type number}, {"likes_hidden", type logical}, {"engagement_rate", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Exception

