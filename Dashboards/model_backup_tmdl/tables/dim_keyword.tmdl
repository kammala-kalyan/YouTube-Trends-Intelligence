/// Curated keyword list (keywords.py) with topic group and language. 'cricket' is the Trends anchor.
table dim_keyword
	lineageTag: 11cc156c-8e22-4031-8a93-3f55affbcc12

	column keyword
		dataType: string
		isKey
		lineageTag: db529131-2b8b-487a-84e1-149c7beb3ea5
		sourceColumn: keyword

	column topic_group
		dataType: string
		lineageTag: 9d6ddb70-df21-447a-ac11-5cf3daa6af5b
		sourceColumn: topic_group

	column keyword_lang
		dataType: string
		isHidden
		lineageTag: 0ebd37e5-439d-463a-957a-055a64522593
		sourceColumn: keyword_lang

	column keyword_language
		dataType: string
		lineageTag: dac30764-a5a3-4fba-a5ed-b1fc8ab8c3a5
		sourceColumn: keyword_language

	column keyword_script
		dataType: string
		lineageTag: 8212c134-f551-48b8-aabf-70e42e44f4da
		sourceColumn: keyword_script

	column is_regional
		dataType: boolean
		lineageTag: 5111e57f-0533-4bad-aaff-5dbc1f844c58
		sourceColumn: is_regional

	column is_anchor
		dataType: boolean
		lineageTag: e8189008-0303-496c-8bb2-ad37cddd267e
		sourceColumn: is_anchor

	partition dim_keyword = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_keyword.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"keyword", type text}, {"topic_group", type text}, {"keyword_lang", type text}, {"keyword_language", type text}, {"keyword_script", type text}, {"is_regional", type logical}, {"is_anchor", type logical}}, "en-US")
				in
				    Typed

