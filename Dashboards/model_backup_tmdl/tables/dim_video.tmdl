/// One row per video seen in trending charts or keyword searches. Language = audio track, else title script, else default language.
table dim_video
	lineageTag: 5f70d883-d175-4a47-b4b6-d47a18b3b8ab

	column video_id
		dataType: string
		isKey
		lineageTag: 6dc7f762-a38b-4b5f-b6d2-c933229ee694
