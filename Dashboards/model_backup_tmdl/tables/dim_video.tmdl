	partition dim_video = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_video.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"video_id", type text}, {"title", type text}, {"channel_id", type text}, {"category_id", type text}, {"published_at", type datetime}, {"published_date", type date}, {"publish_hour_ist", Int64.Type}, {"duration_sec", Int64.Type}, {"duration_bucket", type text}, {"is_short", type logical}, {"language", type text}, {"language_source", type text}, {"title_script", type text}, {"tag_count", Int64.Type}, {"title_length", Int64.Type}, {"tags", type text}}, "en-US")
				in
				    Typed

