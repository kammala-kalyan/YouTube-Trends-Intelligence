{
  "name": "YouTube Dark (minimal)",
  "dataColors": ["#ff1f4b", "#308cf6", "#2a904b", "#7d40c8", "#c96a12", "#059eb1"],
  "background": "#0f0f0f",
  "backgroundLight": "#272727",
  "backgroundNeutral": "#3f3f3f",
  "foreground": "#f1f1f1",
  "foregroundNeutralSecondary": "#aaaaaa",
  "foregroundNeutralTertiary": "#717171",
  "tableAccent": "#ff1f4b",
  "good": "#2ba640",
  "neutral": "#aaaaaa",
  "bad": "#f28b2c",
  "minimum": "#3a1d23",
  "center": "#a3203c",
  "maximum": "#ff5c7a",
  "null": "#272727",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Roboto, Segoe UI Semibold, sans-serif", "color": "#f1f1f1" },
    "title":   { "fontSize": 13, "fontFace": "Roboto, Segoe UI Semibold, sans-serif", "color": "#f1f1f1" },
    "header":  { "fontSize": 12, "fontFace": "Roboto, Segoe UI Semibold, sans-serif", "color": "#f1f1f1" },
    "label":   { "fontSize": 10, "fontFace": "Roboto, Segoe UI, sans-serif", "color": "#aaaaaa" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#0f0f0f" } }, "transparency": 0 }],
        "border": [{ "show": false, "radius": 12 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 8, "bottom": 8, "left": 10, "right": 10 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#f1f1f1" } }, "fontSize": 13, "fontFamily": "Roboto, Segoe UI Semibold, sans-serif" }],
        "subTitle": [{ "fontColor": { "solid": { "color": "#aaaaaa" } }, "fontSize": 10 }],
        "valueAxis": [{ "gridlineShow": true, "gridlineColor": { "solid": { "color": "#2a2a2a" } }, "gridlineThickness": 1, "gridlineStyle": "solid", "labelColor": { "solid": { "color": "#717171" } }, "showAxisTitle": false }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#aaaaaa" } }, "showAxisTitle": false, "gridlineShow": false }],
        "legend": [{ "labelColor": { "solid": { "color": "#aaaaaa" } }, "position": "TopLeft", "fontSize": 10 }],
        "labels": [{ "color": { "solid": { "color": "#f1f1f1" } }, "fontSize": 10 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0f0f0f" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#0f0f0f" } } }]
      }
    },
    "card": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#272727" } }, "transparency": 0 }],
        "border": [{ "show": false, "radius": 12 }],
        "labels": [{ "color": { "solid": { "color": "#f1f1f1" } }, "fontSize": 26 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#aaaaaa" } }, "fontSize": 10 }]
      }
    },
    "cardVisual": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#272727" } }, "transparency": 0 }],
        "border": [{ "show": false, "radius": 12 }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#272727" } }, "transparency": 0 }],
        "border": [{ "show": false, "radius": 18 }],
        "header": [{ "fontColor": { "solid": { "color": "#aaaaaa" } }, "textSize": 9 }],
        "items": [{ "fontColor": { "solid": { "color": "#f1f1f1" } }, "background": { "solid": { "color": "#272727" } }, "textSize": 10 }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2, "showMarker": false }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#2a2a2a" } }, "gridVertical": false, "outlineColor": { "solid": { "color": "#0f0f0f" } } }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#aaaaaa" } }, "backColor": { "solid": { "color": "#0f0f0f" } }, "fontFamily": "Roboto, Segoe UI Semibold, sans-serif" }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#f1f1f1" } }, "backColorPrimary": { "solid": { "color": "#0f0f0f" } }, "fontColorSecondary": { "solid": { "color": "#f1f1f1" } }, "backColorSecondary": { "solid": { "color": "#0f0f0f" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#aaaaaa" } }, "backColor": { "solid": { "color": "#0f0f0f" } } }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#f1f1f1" } }, "backColor": { "solid": { "color": "#0f0f0f" } } }]
      }
    }
  }
}
